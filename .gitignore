# ------------------------------------------------------------------
# Build products. Everything the build produces lives under out/;
# build/ only holds scripts and configuration and is committed.
# ------------------------------------------------------------------
/out/

# Dependency cache. Not committed, but do not delete: offline
# configure depends on it.
/.cpm_cache/

# Node packages
node_modules/

# Playwright output
test-results/
playwright-report/

# Generated sources
/generated/

# ------------------------------------------------------------------
# IDE / tooling
# ------------------------------------------------------------------
CMakeLists.txt.user*
CMakeUserPresets.json
compile_commands.json
.vs/
.vscode/
.cache/
.idea/
cmake-build-*/

# ------------------------------------------------------------------
# Compiler / linker leftovers
# ------------------------------------------------------------------
*.[oa]
*~
moc_*.cpp
ui_*.h
!/src/shell/qt_legacy/ui/include/ui_pch.h
Makefile
Makefile.Debug
Makefile.Release
core.*
massif.out*

# ------------------------------------------------------------------
# Packaging leftovers
# ------------------------------------------------------------------
*.nupkg

# ------------------------------------------------------------------

# Tool scratch
.superpowers/

# Clipboard snapshots written under a configured server --root
/.klogg-clipboard-cache/

# URL downloads written under a configured server --root
/.klogg-url-cache/
